{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/voices",
      "destination": "/api/voices.py"
    },
    {
      "source": "/api/speak",
      "destination": "/api/speak.py"
    },
    {
      "source": "/api/proxy-html",
      "destination": "/api/proxy-html.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.py"
    }
  ]
}